name: Auto-Label Issues

on:
  issues:
    types: [opened]

jobs:
  add-labels:
    runs-on: ubuntu-latest

    steps:
      - name: Adicionar Rótulos às Issues
        uses: actions-ecosystem/action-add-labels@v1
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          labels: |
            - bug
            - feature
            - task
            - enhancement
            - urgent
