name: Auto-Move Issues and PRs to Project Beta

on:
  issues:
    types: [opened, closed]
  pull_request:
    types: [opened, closed]

jobs:
  move-to-project:
    runs-on: ubuntu-latest

    steps:
      - name: Mover para Projeto Beta com Base no Label
        if: github.event.action == 'opened'
        uses: actions/add-to-project@v1.0.2
        with:
          project-url: PVT_kwHOAjTi784Av6rA # Substitua pelo Node ID do Projeto Beta
          github-token: ${{ secrets.GITHUB_TOKEN }}
          labeled: bug, feature, urgent, enhancement
          label-operator: OR

      - name: Mover para Done ao Fechar
        if: github.event.action == 'closed'
        uses: actions/add-to-project@v1.0.2
        with:
          project-url: PVT_kwHOAjTi784Av6rA # Substitua pelo Node ID do Projeto Beta
          github-token: ${{ secrets.GITHUB_TOKEN }}
          field: Status
          field-value: Done
